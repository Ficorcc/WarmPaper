---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { DEFAULT_CONFIG } from '../../config';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const categoryMap: Record<string, typeof allPosts> = {};
  
  for (const post of allPosts) {
    if (post.data.categories) {
      for (const category of post.data.categories) {
        if (!categoryMap[category]) {
          categoryMap[category] = [];
        }
        categoryMap[category].push(post);
      }
    }
  }
  
  return Object.entries(categoryMap).map(([category, posts]) => ({
    params: { category },
    props: { category, posts },
  }));
}

interface Props {
  category: string;
  posts: Awaited<ReturnType<typeof getCollection<'posts'>>>;
}

const { category, posts } = Astro.props;
const config = DEFAULT_CONFIG;
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout config={config} title={`Category: ${category}`}>
  <h1 class="category-title">
    Category: <span>{category}</span>
  </h1>
  <div class="post-list">
    {sortedPosts.map((post) => (
      <PostCard post={post} excerptLink={config.excerptLink} />
    ))}
  </div>
</BaseLayout>