---
import BaseLayout from '../layouts/BaseLayout.astro';
import Profile from '../components/Profile.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { DEFAULT_CONFIG } from '../config';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const postsPerPage = 10;
  const totalPages = Math.ceil(sortedPosts.length / postsPerPage);

  // Generate paths for pages 2 through totalPages
  return Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((page) => ({
    params: { page: String(page) },
    props: { page, sortedPosts, postsPerPage, totalPages },
  }));
}

const { page, sortedPosts, postsPerPage, totalPages } = Astro.props;
const config = DEFAULT_CONFIG;
const start = (page - 1) * postsPerPage;
const posts = sortedPosts.slice(start, start + postsPerPage);
---

<BaseLayout config={config}>
  {config.profile && <Profile profile={config.profile} site={config.site} />}
  
  <div class="post-list">
    {posts.map((post) => (
      <PostCard post={post} excerptLink={config.excerptLink} />
    ))}
  </div>
  
  <Pagination currentPage={page} totalPages={totalPages} baseUrl="/" />
</BaseLayout>
