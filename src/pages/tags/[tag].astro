---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { DEFAULT_CONFIG } from '../../config';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const tagMap: Record<string, typeof allPosts> = {};
  
  for (const post of allPosts) {
    if (post.data.tags) {
      for (const tag of post.data.tags) {
        if (!tagMap[tag]) {
          tagMap[tag] = [];
        }
        tagMap[tag].push(post);
      }
    }
  }
  
  return Object.entries(tagMap).map(([tag, posts]) => ({
    params: { tag },
    props: { tag, posts },
  }));
}

interface Props {
  tag: string;
  posts: Awaited<ReturnType<typeof getCollection<'posts'>>>;
}

const { tag, posts } = Astro.props;
const config = DEFAULT_CONFIG;
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout config={config} title={`Tag: ${tag}`}>
  <h1 class="tag-title">
    Tag: <span>{tag}</span>
  </h1>
  <div class="post-list">
    {sortedPosts.map((post) => (
      <PostCard post={post} excerptLink={config.excerptLink} />
    ))}
  </div>
</BaseLayout>